# Copy to .env and fill in. Nothing here is sent to Tandem; the sandbox only
# talks to your identity provider.

# Origin(s) of the web app that embeds the sandbox iframe, comma-separated.
# Messages from any other origin are ignored, exactly as Tandem does.
PARTNER_ORIGINS=http://localhost:3000

# The value Tandem sends as `partner` in AuthorizeWithoutRedirect and expects
# back unchanged in CustomTokenExchangeResponseAuthCode.
PARTNER_NAME=Example EHR

# The app registration for Tandem in YOUR identity provider (the one whose
# details you would share with Tandem for production). Tandem uses the client
# id in AuthorizeWithoutRedirect and the secret when exchanging your code.
# The secret stays on this machine.
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# OpenID Connect discovery document of your identity provider, e.g. for
# Microsoft Entra ID:
# https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
IDP_WELL_KNOWN_URL=

# Where the sandbox listens. Keep the host on 127.0.0.1.
SANDBOX_PORT=8000

# Local development only: allow an http:// identity provider (e.g. the mock
# IdP in test/). Tandem itself only ever talks to https:// providers.
# ALLOW_INSECURE_IDP=true
